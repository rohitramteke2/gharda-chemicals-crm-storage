    "description": "Node.js API to download Zoho CRM attachments and store them on RDP/VM",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "start": "cross-env NODE_ENV=production node server.js",
        "dev": "cross-env NODE_ENV=development node --watch server.js"
