# ═══════════════════════════════════════════════════════════════════════════
#  PRODUCTION — Gharda RDP / VM server
#  Loaded automatically when: NODE_ENV=production
#  Start command:  set NODE_ENV=production && node server.js
#                  (or use: npm start)
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000
API_VERSION=v1

# ── Security ────────────────────────────────────────────────────────────────
API_KEY=628e9c83c95e3cd344152d367bb24844bdfa0455e5110c2e31c382428c65174c
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Zoho CRM (Gharda Production — Server-Based Client) ─────────────────────
#
#   OPTION A: Standard Zoho Cloud (accounts.zoho.in → www.zohoapis.in)
#   This is what works in Postman and on the local machine.
#
ZOHO_CLIENT_ID=1000.WSUYSR369YWS2W139AVJFSI7A7BR9N
ZOHO_CLIENT_SECRET=79b7221e18997e74123603c5bec28d35ddef30f70d
ZOHO_REFRESH_TOKEN=1000.40d61397d3ffff2777fe74b83a3e1340.19b20fd427917c96c22d516a90c54e62
ZOHO_REDIRECT_URI=https://www.gharda.com/
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_SKIP_SSL_VERIFY=false

#   OPTION B: Private Zoho on-premises (zoho.gharda.com:14443)
#   Uncomment these AND set ZOHO_SKIP_SSL_VERIFY=true if using the internal instance.
#   NOTE: You need DIFFERENT client_id / client_secret from the private console.
#
# ZOHO_ACCOUNTS_URL=https://zoho.gharda.com:14443/oauth/v2/token
# ZOHO_API_DOMAIN=https://zoho.gharda.com:14443
# ZOHO_SKIP_SSL_VERIFY=true

# ── Storage (Windows paths for RDP) ────────────────────────────────────────
ATTACHMENT_DIR=C:\Users\zoho.crm\Desktop\storage\attachments

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=C:\Users\zoho.crm\Desktop\storage\logs

CLUSTER_WORKERS=1
