# ═══════════════════════════════════════════════════════════════════════════
#  PRODUCTION — Gharda RDP / VM server
#  Loaded automatically when: NODE_ENV=production
#  Start command:  npm start   (or: set NODE_ENV=production && node server.js)
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000
API_VERSION=v1

# ── Security ────────────────────────────────────────────────────────────────
API_KEY=6b1dfc2517e17aaa5df5558aaf86f4419ced36866476e4e57662934403e125e3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Zoho CRM (Gharda Production — Server-Based Client) ─────────────────────
#
#   Uses standard Zoho Cloud (accounts.zoho.in → www.zohoapis.in)
#   zoho.gharda.com:14443 is our VM — NOT a Zoho API endpoint.
#
ZOHO_CLIENT_ID=1000.WSUYSR369YWS2W139AVJFSI7A7BR9N
ZOHO_CLIENT_SECRET=79b7221e18997e74123603c5bec28d35ddef30f70d
ZOHO_REFRESH_TOKEN=1000.634f35554a96d7549d0eef23ca0ec26c.24014f6467e945ed2e890624a732f7cc
ZOHO_REDIRECT_URI=https://www.gharda.com/
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_SKIP_SSL_VERIFY=false

# ── Public URL (used in API responses for storage_url) ─────────────────────
PUBLIC_BASE_URL=https://zoho.gharda.com:14443/production

# ── Storage (sibling folder to gharda-crm-api) ────────────────────────────
#   Structure: production/
#              ├── gharda-crm-api/   ← this code
#              └── storage/          ← ATTACHMENT_DIR points here
#                  └── Accounts/
#                      └── {SAP_ID}/
#
ATTACHMENT_DIR=C:\Users\zoho.crm\Desktop\production\storage

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=C:\Users\zoho.crm\Desktop\production\storage\logs

CLUSTER_WORKERS=1


ZOHO_CREATOR_OWNER=zohoadmin_gharda782
ZOHO_CREATOR_APP=distributor-management-gharda-chemical


SQL_SERVER=localhost
SQL_DATABASE=ZOHO
SQL_USER=zoho
SQL_PASSWORD=Zoho@123
SQL_PORT=1433
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
SQL_CONNECTION_TIMEOUT=30000
SQL_REQUEST_TIMEOUT=30000