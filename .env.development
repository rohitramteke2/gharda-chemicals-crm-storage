# ═══════════════════════════════════════════════════════════════════════════
#  DEVELOPMENT — local Windows machine
#  Loaded automatically when: NODE_ENV=development  (or unset)
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Security ────────────────────────────────────────────────────────────────
# Leave blank to disable API key auth in dev (set it to test auth locally)
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ── Zoho CRM (Sandbox / Dev account) ───────────────────────────────────────
ZOHO_CLIENT_ID=1000.WSUYSR369YWS2W139AVJFSI7A7BR9N
ZOHO_CLIENT_SECRET=79b7221e18997e74123603c5bec28d35ddef30f70d
ZOHO_REFRESH_TOKEN=1000.40d61397d3ffff2777fe74b83a3e1340.19b20fd427917c96c22d516a90c54e62
ZOHO_REDIRECT_URI=http://localhost:3000/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_API_DOMAIN=https://www.zohoapis.in

# No SSL bypass needed — standard Zoho cloud has valid certs
ZOHO_SKIP_SSL_VERIFY=false

# ── Storage ─────────────────────────────────────────────────────────────────
ATTACHMENT_DIR=./storage/attachments

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

CLUSTER_WORKERS=1