# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
API_KEY=<YOUR_API_KEY>
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────
# ZOHO CRM
# ─────────────────────────────────────────────
ZOHO_CLIENT_ID=<YOUR_CLIENT_ID>
ZOHO_CLIENT_SECRET=YOUR_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
# ZOHO_ACCESS_TOKEN=1000.b3365abf12135bd19645a7aa8c82c32c.2099a5403ee798de639ec80e71588e00
ZOHO_REDIRECT_URI=https://www.zohoapis.in/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
CODE=<YOUR_SCOPE_CODE>

# ─────────────────────────────────────────────
# SQL DATABASE (MSSQL / RDP Server)
# ─────────────────────────────────────────────
SQL_SERVER=your_rdp_server_ip
SQL_DATABASE=your_database_name
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_CERT=false
SQL_CONNECTION_TIMEOUT=30000
SQL_REQUEST_TIMEOUT=30000

# ─────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────
STORAGE_BASE_PATH=./storage/crm-data

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

ATTACHMENT_STORAGE_PATH=./storage/attachments