# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Cluster ───────────────────────────────────────────────────────────────────
# Number of worker processes to fork. Defaults to number of CPU cores.
# Set to 1 to disable clustering (useful for debugging).
CLUSTER_WORKERS=4

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your_api_key_here

# Rate limit — per-second window for high throughput (200 req/s default)
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=200

# ── Zoho CRM (IN region) ──────────────────────────────────────────────────────
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token
ZOHO_REDIRECT_URI=https://www.zohoapis.in/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=./storage/crm-data
ATTACHMENT_STORAGE_PATH=./storage/attachments

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
