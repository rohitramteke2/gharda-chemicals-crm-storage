# ═══════════════════════════════════════════════════════════════════════════
#  ENV TEMPLATE — Copy to .env.development or .env.production and fill in
#
#  The server loads:
#    npm run dev  → .env.development
#    npm start    → .env.production
#    fallback     → .env (if neither above exists)
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Security ────────────────────────────────────────────────────────────────
API_KEY=<generate a random 64-char hex string>
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Zoho CRM ───────────────────────────────────────────────────────────────
#   Get these from: https://api-console.zoho.in/
#   Create a "Server-Based Application" client type.
#
ZOHO_CLIENT_ID=<your_zoho_client_id>
ZOHO_CLIENT_SECRET=<your_zoho_client_secret>
ZOHO_REFRESH_TOKEN=<your_zoho_refresh_token>
ZOHO_REDIRECT_URI=<your_redirect_uri>
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_SKIP_SSL_VERIFY=false

# ── Public URL (used in API responses for storage_url and HTML pages) ──────
#   Dev:  http://localhost:3000
#   Prod: https://zoho.gharda.com:14443/production
#
PUBLIC_BASE_URL=http://localhost:3000

# ── Storage ─────────────────────────────────────────────────────────────────
#   Where downloaded files are saved. This folder is also served via /storage/
#
#   Dev (relative):  ../storage
#   Prod (absolute): C:\Users\zoho.crm\Desktop\production\storage
#
#   Structure:
#     {ATTACHMENT_DIR}/
#       └── Accounts/
#           └── {SAP_ID}/
#               ├── Pesticide_Liscense/
#               │   └── license.pdf
#               └── ...
#
ATTACHMENT_DIR=../storage

# ── Logging ─────────────────────────────────────────────────────────────────
#   Levels: error, warn, info, http, debug
#
LOG_LEVEL=info
LOG_DIR=./logs

# ── Cluster ─────────────────────────────────────────────────────────────────
#   Number of worker processes. Leave empty to auto-detect (max 4).
#   Set to 1 for development.
#
CLUSTER_WORKERS=1

ZOHO_CREATOR_OWNER=zohoadmin_gharda782
ZOHO_CREATOR_APP=distributor-management-gharda-chemical


SQL_SERVER=172.16.0.50
SQL_DATABASE=ZOHO
SQL_USER=zoho
SQL_PASSWORD=Zoho@2026
SQL_PORT=1433
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
SQL_CONNECTION_TIMEOUT=30000
SQL_REQUEST_TIMEOUT=30000


TOKEN_SECRET=6707affa718484c0a78190404046773da67a550dc5a8f38d9abb81d6916d8047